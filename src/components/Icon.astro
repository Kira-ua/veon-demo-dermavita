---
// Functional line icons only (phone, Instagram, menu, close): 1.5px stroke, always beside text or with aria-label on the control.
interface Props { name: "phone" | "instagram" | "menu" | "close"; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5.2 3.5h3.1l1.6 4-2 1.3a11 11 0 0 0 7.3 7.3l1.3-2 4 1.6v3.1a1.7 1.7 0 0 1-1.8 1.7A16.8 16.8 0 0 1 3.5 5.3a1.7 1.7 0 0 1 1.7-1.8Z" />}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8h.01" /></>}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
