---
import FutureLink from "./FutureLink.astro";
import { license, NOTE_SOON } from "../data/clinic";
const img = import.meta.env.BASE_URL.replace(/\/?$/, "/") + "img/";
---
<section id="likari" class="likari section" aria-labelledby="likari-title">
  <div class="container">
    <div class="likari__head">
      <h2 id="likari-title" data-rec="U-R016,P-R002,P-R010">Лікарі й засновники</h2>
      <p class="likari__links">
        <FutureLink note={NOTE_SOON}>Команда</FutureLink>
        <FutureLink note={NOTE_SOON}>Про клініку</FutureLink>
      </p>
    </div>

    <div class="team">
      <figure class="person person--y">
        <picture data-rec="SEO-R003">
          <source type="image/avif" srcset={`${img}yurii-melnychuk-400.avif 400w, ${img}yurii-melnychuk-588.avif 588w`} sizes="(min-width: 64rem) 34vw, (min-width: 40rem) 45vw, 82vw" />
          <source type="image/webp" srcset={`${img}yurii-melnychuk-400.webp 400w, ${img}yurii-melnychuk-588.webp 588w`} sizes="(min-width: 64rem) 34vw, (min-width: 40rem) 45vw, 82vw" />
          <img class="person__photo" src={`${img}yurii-melnychuk-588.webp`} width="588" height="784" loading="lazy" decoding="async" alt="Юрій Мельничук, співзасновник медичного центру DermaVita" />
        </picture>
        <figcaption>
          <h3 class="person__name">Юрій Мельничук</h3>
          <p class="person__role">Співзасновник, керуючий партнер медичного центру DermaVita</p>
        </figcaption>
      </figure>

      <figure class="person person--n">
        <div class="person__slot" role="img" aria-label="Місце для портрета Ніни Скоробогатько, зображення клієнта">
          <span class="person__mono" aria-hidden="true">НС</span>
          <span class="person__slot-note" aria-hidden="true">зображення клієнта</span>
        </div>
        <figcaption>
          <h3 class="person__name">Ніна Скоробогатько</h3>
          <p class="person__role">Співзасновниця DermaVita, у косметології з 2003 року</p>
        </figcaption>
      </figure>

      <ul class="facts">
        <li>Клініку відкрили у 2015 році</li>
        <li>Медичний центр з ліцензією МОЗ: {license.replace("Ліцензія МОЗ ", "")}</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .likari { background: var(--color-layer-1); }
  .likari__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
    margin-bottom: var(--s-8);
  }
  .likari__links { display: flex; gap: var(--s-5); color: var(--color-accent); font-weight: 500; }
  .likari__links :global(.future-link) { min-height: var(--tap); }

  .team { display: grid; gap: var(--s-8); }
  .person { margin: 0; display: grid; gap: var(--s-5); align-content: start; }
  .person--y { width: 82%; }
  .person--n { width: 72%; justify-self: end; }
  .person__photo { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; }
  .person__name {
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .person__role { margin-top: var(--s-2); color: var(--color-muted); max-width: 32ch; }
  .person__slot {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--color-layer-2);
    display: grid;
    place-items: center;
  }
  .person__mono {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(5rem, 3rem + 8vw, 10rem);
    line-height: 1;
    color: var(--color-muted);
  }
  .person__slot-note {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-3);
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
  .facts {
    display: grid;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: 1.25;
    max-width: 30ch;
  }
  .facts li { padding-left: var(--s-5); border-left: 2px solid var(--color-accent); }

  @media (min-width: 40rem) {
    .team { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--s-9); }
    .person--y { width: auto; grid-column: 1 / 7; }
    .person--n { width: auto; grid-column: 8 / -1; margin-top: var(--s-10); }
    .facts { grid-column: 1 / 10; }
  }
  @media (min-width: 64rem) {
    .person--y { grid-column: 1 / 6; }
    .person--n { grid-column: 8 / 12; margin-top: var(--s-11); }
    .facts { grid-column: 1 / 9; }
  }
</style>
