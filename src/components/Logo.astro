---
// Typographic mark in the concept's style (the client's logo file is not used in the demo).
interface Props { tone?: "light" | "deep"; }
const { tone = "light" } = Astro.props;
---
<a href="#top" class:list={["logo", `logo--${tone}`]} aria-label="DermaVita, на початок сторінки">
  <span class="logo__word">DermaVita</span>
  <span class="logo__sub">cosmetology &amp; dermatology</span>
</a>

<style>
  .logo {
    display: inline-grid;
    gap: 2px;
    text-decoration: none;
    color: var(--color-accent);
    min-height: var(--tap);
    align-content: center;
    flex-shrink: 0;
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .logo__sub {
    font-size: 0.6875rem;
    line-height: 1.1;
    color: var(--color-muted);
  }
  .logo--deep { color: var(--color-accent-on-deep); }
  .logo--deep .logo__sub { color: var(--color-on-dark); }
</style>
